# ==============================================================================
# MathSphere AI — Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# --- Database Configuration ---
# Standard PostgreSQL connection string used by src/db/index.ts and drizzle.config.ts.
# For local development with existing PostgreSQL instance on port 5432:
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/Maths

# For managed cloud PostgreSQL (e.g., Neon, Supabase, AWS RDS, Vercel Postgres):
# Always use connection pooling parameters (e.g., ?sslmode=require) in production.
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/mathsphere?sslmode=require

# --- Android Hybrid Build Configuration (Optional for local web dev) ---
# Set only when building an Online-Connected Android APK that communicates
# with your deployed HTTPS Next.js backend. Must use HTTPS and root path.
# CAPACITOR_SERVER_URL=https://mathsphere.example.com
# CAPACITOR_REQUIRE_REMOTE=0
